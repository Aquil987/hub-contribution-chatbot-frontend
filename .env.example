# Leave empty when using Vite's development proxy.
VITE_API_BASE_URL=https://cirdev.softage.net/hub-contributor-support
VITE_API_TIMEOUT_MS=20000
VITE_SHOW_SUGGESTED_QUESTIONS=false

# Development only. Set this to the local FastAPI origin.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000

# Never place OpenAI or other private API keys in VITE_* variables.
